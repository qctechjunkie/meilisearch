# Meilisearch Environment Configuration

# Environment mode: development or production
# In development mode, the API is more permissive
# In production mode, a master key is required
MEILI_ENV=development

# Master key for authentication
# IMPORTANT: Replace this with a secure random string
# Generate a secure key using: openssl rand -base64 32
# This key is used to create API keys and authenticate requests
MEILI_MASTER_KEY=REPLACE_THIS_WITH_YOUR_SECURE_MASTER_KEY

DOCKER_DATA_PATH=/meili_data

PORT=7700